# Claude API
CLAUDE_API_KEY=sk-ant-xxxxx

# Google Cloud
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
MANAGEMENT_SHEET_ID=1ABCdef...

# 作業ディレクトリ
HOJOKIN_BASE_DIR=c:/Users/user/projects/カラフルボックス/補助金

# Google Document AI (Phase 3 OCR、賃金台帳PDFのOCR用)
# Streamlit Cloud では Secrets として設定する。
# - DOCUMENT_AI_PROCESSOR_ID は GCPコンソールで Enterprise Document OCR を作成して取得
# - USE_DOCUMENT_AI_OCR=true で有効化（既定 false）
DOCUMENT_AI_PROJECT_ID=hojokin-automation
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=xxxxxxxxxxxxxxxx
USE_DOCUMENT_AI_OCR=false

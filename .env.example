# Claude API
CLAUDE_API_KEY=sk-ant-xxxxx

# Google Cloud
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
MANAGEMENT_SHEET_ID=1ABCdef...

# 作業ディレクトリ
HOJOKIN_BASE_DIR=c:/Users/user/projects/カラフルボックス/補助金

# Google Document AI (Phase 3 OCR、賃金台帳PDFのOCR用)
# Streamlit Cloud では Secrets として設定する。
# - DOCUMENT_AI_PROCESSOR_ID は GCPコンソールで Enterprise Document OCR を作成して取得
# - USE_DOCUMENT_AI_OCR=true で有効化（既定 false）
DOCUMENT_AI_PROJECT_ID=hojokin-automation
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=xxxxxxxxxxxxxxxx
USE_DOCUMENT_AI_OCR=false

# Haiku モード: 賃金台帳を「Document AI で OCR → Haiku 4.5 で抽出」に切り替える。
# true にすると USE_DOCUMENT_AI_OCR も自動有効化される（前者の前提が後者）。
# 1案件 約46円 → 約18円（無料中）/ 約27円（90日後）の試算。
# 失敗時は Sonnet 画像経路に自動フォールバック。
USE_OCR_HAIKU_EXTRACTION=false
HAIKU_MODEL=claude-haiku-4-5-20251001

# Sonnet OCR モード（Path C）: 賃金台帳を「Document AI で OCR → Sonnet 4.6 で抽出」に切り替える。
# true にすると USE_DOCUMENT_AI_OCR も自動有効化される。
# Haiku モードよりコスト高だが、Sonnet の構造理解力で品質を最大化する経路。
# Path A（Sonnet 画像直送）の取りこぼし問題と Path B（Haiku）の構造理解の弱さを両方解決する想定。
# USE_OCR_HAIKU_EXTRACTION と同時 true 時は Sonnet を優先（明示的な品質モードを尊重、警告ログを出力）。
USE_DOCUMENT_AI_SONNET_EXTRACTION=false

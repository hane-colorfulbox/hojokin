# 環境変数・シークレット
.env
credentials/
.streamlit/secrets.toml

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# 顧客資料・出力ファイル
output/
1.交付申請_過去採択なし/
# ローカル作業用の顧客資料フォルダ全般を除外（フォルダ名が「○○資料/」のもの）
*資料/

# Excelの一時ファイル
~$*.xlsx

# Excel・PDF（顧客資料）
*.xlsx
*.xls
*.pdf

# ツール/ 配下のテンプレ・ヒアリングシート原本は管理対象（Streamlit Cloud で必要）
!ツール/*.xlsx

# 補助金加点/ 配下の賃金状況報告シート公式様式（記入例のみ・PIIなし）は管理対象
# （加点判定タスクの提出用シート①②生成に必須。Cloud に無いと無警告スキップになる）
!補助金加点/*.xlsx

# .claude/skills/ 配下のテンプレは管理対象（Skill 同梱、ZIP ビルドのソース）
!.claude/skills/**/*.xlsx

# Skill ZIP 配布物（生成物、Drive 経由で配布するため git 管理しない）
_dist/

# Skill テスト時の顧客データ（PDF/ヒアリング/案件メタ/テストレポート）
# 顧客企業名・従業員氏名・金額が含まれるため絶対にコミットしない
_test_meta/

# ローカル個人バックアップ（Codex レビュー結果プロンプト等、顧客情報が混入する可能性）
_backups/

# .claude/ の個人ファイル（CC 動作中のロックやセッション情報）。Skill 配下だけはホワイトリスト
.claude/*
!.claude/skills/
!.claude/skills/**

# その他
*.log
.DS_Store
Thumbs.db

# ローカル検証用スクラップ
_debug/

# 顧客名・社員氏名・実額などを含むローカルドキュメント
# （業務ルールや調査ログをローカル参照用に残す。GitHub publicに見えると困るので除外）
docs/TODO_2次申請改善.md
docs/補助金_実務知識ベース.md
docs/案件メモ/

# セカンドオピニオン加点：録画文字起こし・社長意向・各社カスタムは社外秘/PIIのため除外
# （制度説明・支援方針たたき台・汎用配布テンプレ＝PII無しは追跡可のまま残す）
docs/セカンドオピニオン加点/_transcripts/
docs/セカンドオピニオン加点/社長意向_*.md
docs/セカンドオピニオン加点/設計_*.md
docs/セカンドオピニオン加点/議事_*.md
docs/セカンドオピニオン加点/案件別/
# 参考_*.md：自社プロダクト（Scale等）の内部整理ナレッジ。競合比較・価格ロジック等を含むため除外
docs/セカンドオピニオン加点/参考_*.md

# ローカル個別設定
.gitignore.local
